{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "$lib": [ "src/lib" ],
      "$lib/*": [ "src/lib/*" ]
    }
  },
  "include": [ "src/lib/**/*.ts" ]
}