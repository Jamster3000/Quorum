{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "$lib": [ "src/lib" ],
      "$lib/*": [ "src/lib/*" ]
    },
    "include": [ "src/**/*" ],
    "exclude": [ "node_modules", "build", "dist" ]
  }
}