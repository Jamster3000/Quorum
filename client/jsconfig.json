{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "moduleResolution": "bundler",
    "types": [ "vite/client", "@sveltejs/kit" ]
  },
  "include": [ "src/**/*.ts", "src/**/*.svelte" ],
  "exclude": [ "src/**/stories/**" ]
}