# Server Configuration
SERVER_PORT=3000
SERVER_HOST=127.0.0.1
SERVER_URL=http://127.0.0.1:3000

# SurrealDB Configuration
SURREAL_URL=localhost:8000
SURREAL_USER=root
SURREAL_PASS=root
